{
  "manifest_version": 3,
  "name": "Сохранение выделений",
  "version": "1.1",
  "description": "Подсвечивает и сохраняет выделенный текст через контекстное меню.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
